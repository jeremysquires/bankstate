[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
pypdf = ">=3.5.0"
python-dateutil = ">=2.8.2"
pymupdf = ">=1.21.1"

[dev-packages]
black = "*"
pylint = "*"

[scripts]
format = "black *.py"
lint = "pylint ."
test = "python -m unittest discover -s test -v"
test_bmo_bank = "python pdf2txt.py ./test/data/bmo_bank.pdf bmo_bank ./test/data/bmo_bank.tsv -c ./test/data/raw/bmo_bank.txt"
test_bmo_card = "python pdf2txt.py ./test/data/bmo_card.pdf bmo_card ./test/data/bmo_card.tsv -c ./test/data/raw/bmo_card.txt"
test_bmo_card2 = "python pdf2txt.py ./test/data/bmo_card2.pdf bmo_card ./test/data/bmo_card2.tsv -c ./test/data/raw/bmo_card2.txt"
test_rbc_bank = "python pdf2txt.py ./test/data/rbc_bank.pdf rbc_bank ./test/data/rbc_bank.tsv -c ./test/data/raw/rbc_bank.txt"
test_rbc_bank2 = "python pdf2txt.py ./test/data/rbc_bank2.pdf rbc_bank ./test/data/rbc_bank2.tsv -c ./test/data/raw/rbc_bank2.txt"
test_rbc_bank_2023 = "python pdf2txt.py ./test/data/rbc_bank_2023.pdf rbc_bank ./test/data/rbc_bank_2023.tsv -c ./test/data/raw/rbc_bank_2023.txt"
test_rbc_bank_2025 = "python pdf2txt.py ./test/data/rbc_bank_2025.pdf rbc_bank ./test/data/rbc_bank_2025.tsv -c ./test/data/raw/rbc_bank_2025.txt"
test_rbc_card = "python pdf2txt.py ./test/data/rbc_card.pdf rbc_card ./test/data/rbc_card.tsv -c ./test/data/raw/rbc_card.txt"

[requires]
python_version = "3.8"
